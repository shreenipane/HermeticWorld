+// SPDX-License-Identifier: Apache-2.0
+//! Host enforcement for guests that can execute arbitrary kernel instructions.
+use kvm_bindings::{
+    KVM_CAP_ENFORCE_PV_FEATURE_CPUID, KVM_EXIT_XEN, KVM_EXIT_XEN_HCALL,
+    KVM_XEN_HVM_CONFIG_INTERCEPT_HCALL, KVMIO, kvm_enable_cap, kvm_run, kvm_xen_hvm_config,
+};
+use kvm_ioctls::{Cap, MsrFilterDefaultAction, MsrFilterRange, MsrFilterRangeFlags, VcpuFd, VmFd};
+use vmm_sys_util::{errno, ioctl::ioctl_with_ref, ioctl_iow_nr};
+
+// kvm-ioctls 0.25 has no Xen configuration wrapper.
+#[allow(missing_docs)]
+mod ioctls {
+    use super::*;
+    ioctl_iow_nr!(KVM_XEN_HVM_CONFIG, KVMIO, 0x7a, kvm_xen_hvm_config);
+}
+
+/// Fixed guest identity and virtual counter policy.
+#[path = "cpu_baseline.rs"]
+pub mod baseline;
+
+/// Construct a fresh bounded CPUID set without any host-derived entries.
+pub fn sealed_cpuid(index: u8, count: u8) -> Result<kvm_bindings::CpuId, errno::Error> {
+    let mut entries = Vec::with_capacity(baseline::MAX_CPUID_ENTRIES);
+    for (leaf, subleaf) in baseline::queries() {
+        let [eax, ebx, ecx, edx] = baseline::registers(leaf, subleaf, index, count)
+            .ok_or_else(|| errno::Error::new(libc::EINVAL))?;
+        if entries.len() >= baseline::MAX_CPUID_ENTRIES {
+            return Err(errno::Error::new(libc::E2BIG));
+        }
+        entries.push(kvm_bindings::kvm_cpuid_entry2 {
+            function: leaf, index: subleaf,
+            flags: if matches!(leaf, 4 | 7 | 0xb | 0xd) { 1 } else { 0 },
+            eax, ebx, ecx, edx, ..Default::default()
+        });
+    }
+    kvm_bindings::CpuId::from_entries(&entries).map_err(|_| errno::Error::new(libc::EINVAL))
+}
+
+/// Refuse unsupported vendors/features instead of advertising unavailable instructions.
+pub fn host_supported(cpuid: &kvm_bindings::CpuId) -> bool {
+    if cpuid.as_slice().len() > baseline::MAX_CPUID_ENTRIES { return false; }
+    let get = |leaf| cpuid.as_slice().iter().find(|e| e.function == leaf && e.index == 0);
+    get(0).is_some_and(|r| [r.ebx, r.edx, r.ecx] == [0x756e6547, 0x49656e69, 0x6c65746e])
+        && get(1).is_some_and(|r| r.ecx & baseline::FEATURES_ECX == baseline::FEATURES_ECX
+            && r.edx & baseline::FEATURES_EDX == baseline::FEATURES_EDX)
+        && get(0x80000001).is_some_and(|r| r.ecx & 1 == 1
+            && r.edx & 0x20100800 == 0x20100800)
+        && get(0x80000007).is_some_and(|r| r.edx & (1 << 8) != 0)
+        && get(0x80000008).is_some_and(|r| r.eax & 0xff >= 36 && (r.eax >> 8) & 0xff >= 48)
+}
+
+/// Require hardware TSC scaling even when the host happens to run at 2 GHz.
+pub fn fixed_tsc(vcpu: &VcpuFd) -> Result<(), errno::Error> {
+    set_and_verify_tsc(|khz| vcpu.set_tsc_khz(khz), || vcpu.get_tsc_khz())
+}
+
+fn set_and_verify_tsc(set: impl FnOnce(u32) -> Result<(), errno::Error>,
+                      get: impl FnOnce() -> Result<u32, errno::Error>) -> Result<(), errno::Error> {
+    set(baseline::TSC_KHZ)?;
+    if get()? != baseline::TSC_KHZ { return Err(errno::Error::new(libc::ENOTSUP)); }
+    Ok(())
+}
+
+/// Reject a snapshot before applying its state; it may not select another rate/profile.
+pub fn restore_cpuid(input: &kvm_bindings::CpuId, index: u8, khz: Option<u32>)
+    -> Result<kvm_bindings::CpuId, errno::Error> {
+    if khz != Some(baseline::TSC_KHZ) || input.as_slice().len() > baseline::MAX_CPUID_ENTRIES {
+        return Err(errno::Error::new(libc::EINVAL));
+    }
+    let count = input.as_slice().iter().find(|e| e.function == 1 && e.index == 0)
+        .map(|e| ((e.ebx >> 16) & 0xff) as u8).ok_or_else(|| errno::Error::new(libc::EINVAL))?;
+    let expected = sealed_cpuid(index, count)?;
+    // KVM rewrites CPUID.0xD.0:EBX at runtime (kvm_update_cpuid_runtime) to the
+    // save-area size of the guest's XCR0. The profile has no XSAVE, so XCR0 stays
+    // x87-only and a saved readback holds exactly KVM_XSAVE_LEGACY_SIZE. Accept only
+    // that one recomputed field, then install the sealed template unchanged.
+    let mut saved = input.clone();
+    if let Some(e) = saved.as_mut_slice().iter_mut().find(|e| e.function == 0xd && e.index == 0) {
+        if e.ebx == KVM_XSAVE_LEGACY_SIZE { e.ebx = 0; }
+    }
+    // Serialization order is fixed as well as values, flags, and padding.
+    if saved != expected { return Err(errno::Error::new(libc::EINVAL)); }
+    Ok(expected)
+}
+
+/// KVM's CPUID.0xD.0:EBX for an x87-only XCR0 (legacy area plus header).
+pub const KVM_XSAVE_LEGACY_SIZE: u32 = 0x240;
+
+/// Deny old/new KVM PV MSRs and the Hyper-V/Xen synthetic range, in both directions.
+pub fn ranges() -> [MsrFilterRange<'static>; 3] {
+    let flags = MsrFilterRangeFlags::READ | MsrFilterRangeFlags::WRITE;
+    [
+        MsrFilterRange { flags, base: 0x11, msr_count: 2, bitmap: &[0] },
+        MsrFilterRange { flags, base: 0x4b56_4d00, msr_count: 256, bitmap: &[0; 32] },
+        MsrFilterRange { flags, base: 0x4000_0000, msr_count: 512, bitmap: &[0; 64] },
+    ]
+}
+
+/// Called on every new VM fd, including the snapshot restore path, before vCPUs.
+pub fn install(vm: &VmFd) -> Result<(), errno::Error> {
+    if vm.check_extension_int(Cap::TscControl) != 1
+        || vm.check_extension_int(Cap::X86MsrFilter) != 1
+        || vm.check_extension_int(Cap::XenHvm) & (KVM_XEN_HVM_CONFIG_INTERCEPT_HCALL as i32) == 0
+        || vm.check_extension_raw(u64::from(KVM_CAP_ENFORCE_PV_FEATURE_CPUID)) != 1
+    {
+        return Err(errno::Error::new(libc::ENOTSUP));
+    }
+    // Filtered accesses must inject #GP, never be serviced by userspace.
+    vm.enable_cap(&kvm_enable_cap { cap: kvm_bindings::KVM_CAP_X86_USER_SPACE_MSR,
+        ..Default::default() })?;
+    vm.set_msr_filter(MsrFilterDefaultAction::ALLOW, &ranges())?;
+    let config = kvm_xen_hvm_config {
+        flags: KVM_XEN_HVM_CONFIG_INTERCEPT_HCALL,
+        // A nonzero synthetic MSR activates KVM's Xen static key. Guest access
+        // to this MSR is denied above, preventing hypercall-page installation.
+        msr: 0x4000_0000,
+        ..Default::default()
+    };
+    // SAFETY: vm is a VM fd; config is an initialized fixed-size UAPI object.
+    let ret = unsafe { ioctl_with_ref(vm, ioctls::KVM_XEN_HVM_CONFIG(), &config) };
+    if ret != 0 { return Err(errno::Error::last()); }
+    Ok(())
+}
+
+/// Re-enable after every CPUID installation, including snapshot restoration.
+pub fn enforce_pv(vcpu: &VcpuFd) -> Result<(), errno::Error> {
+    vcpu.enable_cap(&kvm_enable_cap { cap: KVM_CAP_ENFORCE_PV_FEATURE_CPUID,
+        args: [1, 0, 0, 0], ..Default::default() })
+}
+
+/// Complete intercepted calls without reading any host state or guest memory.
+pub fn deny_xen(run: &mut kvm_run) -> bool {
+    if run.exit_reason != KVM_EXIT_XEN { return false; }
+    // SAFETY: KVM_EXIT_XEN selects the xen union arm. The type selects hcall.
+    let xen = unsafe { &mut run.__bindgen_anon_1.xen };
+    if xen.type_ != KVM_EXIT_XEN_HCALL { return false; }
+    // SAFETY: The discriminator above selects hcall. Only result is changed.
+    xen.u.hcall.result = (-libc::ENOSYS as i64) as u64;
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scaled_tsc_errors_and_mismatched_readback_fail_closed() {
+        assert!(set_and_verify_tsc(|khz| { assert_eq!(khz, 2_000_000); Ok(()) },
+                                  || Ok(2_000_000)).is_ok());
+        for frequency in [0, 1, 2_400_000, u32::MAX] {
+            assert!(set_and_verify_tsc(|khz| { assert_eq!(khz, 2_000_000); Ok(()) },
+                                      || Ok(frequency)).is_err());
+        }
+        assert!(set_and_verify_tsc(|_| Err(errno::Error::new(libc::ENOTSUP)),
+                                  || panic!("readback after failed SET_TSC_KHZ")).is_err());
+        assert!(set_and_verify_tsc(|_| Ok(()), || Err(errno::Error::new(libc::EIO))).is_err());
+    }
+
+    #[test]
+    fn fixed_identity_rejects_incompatible_hosts_and_snapshot_mutations() {
+        let good = sealed_cpuid(0, 1).unwrap();
+        assert!(host_supported(&good));
+        assert!(restore_cpuid(&good, 0, Some(baseline::TSC_KHZ)).is_ok());
+        for khz in [None, Some(0), Some(2_400_000)] {
+            assert!(restore_cpuid(&good, 0, khz).is_err());
+        }
+        for leaf in [0, 1, 0x80000001, 0x80000007, 0x80000008] {
+            let mut bad = good.clone();
+            let entry = bad.as_mut_slice().iter_mut().find(|e| e.function == leaf).unwrap();
+            entry.eax = 0; entry.ebx = 0; entry.ecx = 0; entry.edx = 0;
+            assert!(!host_supported(&bad));
+        }
+        for count in [1, 2, 3, 32] {
+            for index in 0..count {
+                let cpuid = sealed_cpuid(index, count).unwrap();
+                assert!(restore_cpuid(&cpuid, index, Some(baseline::TSC_KHZ)).is_ok());
+                for pos in 0..cpuid.as_slice().len() {
+                    let mut bad = cpuid.clone();
+                    bad.as_mut_slice()[pos].eax ^= 1;
+                    assert!(restore_cpuid(&bad, index, Some(baseline::TSC_KHZ)).is_err());
+                }
+            }
+        }
+        // A snapshot holds KVM's readback, not the template: 0xD.0 EBX is recomputed.
+        for count in [1, 2] {
+            let mut readback = sealed_cpuid(0, count).unwrap();
+            let e = readback.as_mut_slice().iter_mut().find(|e| e.function == 0xd && e.index == 0).unwrap();
+            e.ebx = KVM_XSAVE_LEGACY_SIZE;
+            let restored = restore_cpuid(&readback, 0, Some(baseline::TSC_KHZ)).unwrap();
+            assert_eq!(restored, sealed_cpuid(0, count).unwrap());
+            for other in [0x200, 0x340, 0x440, 0x988, 1] {
+                let mut bad = readback.clone();
+                bad.as_mut_slice().iter_mut().find(|e| e.function == 0xd && e.index == 0).unwrap().ebx = other;
+                assert!(restore_cpuid(&bad, 0, Some(baseline::TSC_KHZ)).is_err(), "{other:#x}");
+            }
+            for (leaf, sub) in [(4, 0), (1, 0), (0x16, 0)] {
+                let mut bad = readback.clone();
+                bad.as_mut_slice().iter_mut().find(|e| e.function == leaf && e.index == sub).unwrap().ebx ^= KVM_XSAVE_LEGACY_SIZE;
+                assert!(restore_cpuid(&bad, 0, Some(baseline::TSC_KHZ)).is_err());
+            }
+        }
+        assert!(sealed_cpuid(0, 0).is_err());
+        assert!(sealed_cpuid(0, 33).is_err());
+        assert!(sealed_cpuid(32, 32).is_err());
+    }
+
+    #[test]
+    fn denies_every_pv_clock_msr_in_both_directions() {
+        for msr in [0x11, 0x12, 0x4b564d00, 0x4b564d01, 0x4b564d03,
+                    0x40000000, 0x40000020, 0x40000021, 0x40000022] {
+            let ranges = ranges();
+            let range = ranges.iter().find(|r| msr >= r.base && msr - r.base < r.msr_count).unwrap();
+            assert_eq!(range.flags, MsrFilterRangeFlags::READ | MsrFilterRangeFlags::WRITE);
+            assert!(range.bitmap.iter().all(|b| *b == 0));
+        }
+    }
+
+    #[test]
+    fn intercepted_hypercalls_always_return_enosys() {
+        for input in [9, 0, u64::MAX] {
+            let mut run = kvm_run { exit_reason: KVM_EXIT_XEN, ..Default::default() };
+            run.__bindgen_anon_1.xen.type_ = KVM_EXIT_XEN_HCALL;
+            run.__bindgen_anon_1.xen.u.hcall.input = input;
+            assert!(deny_xen(&mut run));
+            // SAFETY: This fixture initialized the Xen hcall union arm.
+            assert_eq!(unsafe { run.__bindgen_anon_1.xen.u.hcall.result }, (-38i64) as u64);
+        }
+        assert!(!deny_xen(&mut kvm_run::default()));
+    }
+}
