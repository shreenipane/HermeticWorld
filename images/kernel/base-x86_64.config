# Linux/x86 6.1.128 Kernel Configuration
# Minimal built-in Firecracker-style x86_64 MMIO microVM base (TR-VMM-4).

# TR-VMM-4: fixed default guest hostname
CONFIG_DEFAULT_HOSTNAME="hermetic"

# TR-VMM-4: no compiler paths or debug metadata
# CONFIG_DEBUG_INFO is not set

# TR-VMM-4: no local version or host suffix
CONFIG_LOCALVERSION=""

# TR-VMM-4: no random build salt
CONFIG_BUILD_SALT=""

# TR-VMM-4: x86 microVM boot
CONFIG_64BIT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK=y
CONFIG_DEVTMPFS=y
CONFIG_ELF_CORE=y
CONFIG_FHANDLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_INET=y
CONFIG_KVM_GUEST=y
CONFIG_MODULES=y
CONFIG_MULTIUSER=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_PCI=y
CONFIG_PRINTK=y
CONFIG_PROC_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SMP=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_UNIX=y
CONFIG_UNIX98_PTYS=y
CONFIG_X86_64=y

# TR-VMM-4: avoid compiler paths and automatically generated signing keys.
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_IKHEADERS is not set
