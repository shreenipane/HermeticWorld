# Phase 3b proposal only: merge AFTER base-x86_64.config and hermetic.config.
# Never apply on the host. The final olddefconfig output must retain each requested value.
# The active kernel/config/cmdline are intentionally unchanged.
# Remove cooperative KVM guest clock and hypercall hooks; not a host-side filter.
# CONFIG_KVM_GUEST is not set
# Remove paravirtual guest hooks; accept performance cost in the nested experiment.
# CONFIG_PARAVIRT is not set
# Remove the guest KVM PTP clock-pairing driver.
# CONFIG_PTP_1588_CLOCK_KVM is not set
# Remove guest PTP devices that could carry absolute time.
# CONFIG_PTP_1588_CLOCK is not set
# Remove the privileged userspace MSR read/write device.
# CONFIG_X86_MSR is not set
# Remove the device only; CPUID instruction remains available.
# CONFIG_X86_CPUID is not set
# Prevent root loading arbitrary ring-0 code.
# CONFIG_MODULES is not set
# Prevent physical-memory and VMClock mappings through /dev/mem.
# CONFIG_DEVMEM is not set
# Prevent root replacing the kernel through kexec_load.
# CONFIG_KEXEC is not set
# Prevent root replacing the kernel through kexec_file_load.
# CONFIG_KEXEC_FILE is not set
# Remove snapshot memory write/restore interfaces.
# CONFIG_HIBERNATION is not set
# Remove the kernel memory core-file interface.
# CONFIG_PROC_KCORE is not set
# Remove PFN disclosure via pagemap; this is not a hypercall filter.
# CONFIG_PROC_PAGE_MONITOR is not set
# Prevent root acquiring raw legacy port-I/O privileges.
# CONFIG_X86_IOPL_IOPERM is not set
# Prevent root injecting AML methods.
# CONFIG_ACPI_CUSTOM_METHOD is not set
# Remove ACPI debugging interfaces.
# CONFIG_ACPI_DEBUG is not set
# Remove the perf syscall/PMU inspection interface.
# CONFIG_PERF_EVENTS is not set
# Enable the security framework required by lockdown.
CONFIG_SECURITY=y
# Build the lockdown LSM.
CONFIG_SECURITY_LOCKDOWN_LSM=y
# Register lockdown before early boot parameters.
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# Force lockdown even when root controls later userspace.
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
# Limit unprivileged log reads; CAP_SYSLOG root can still read logs.
CONFIG_SECURITY_DMESG_RESTRICT=y
# Remove RTC class devices and sysfs date reads.
# CONFIG_RTC_CLASS is not set
# Remove CMOS RTC driver; x86 persistent-clock setup still needs auditing.
# CONFIG_RTC_DRV_CMOS is not set
# Do not initialize the wall clock from an RTC class device.
# CONFIG_RTC_HCTOSYS is not set
# Remove HPET clocksource support.
# CONFIG_HPET_TIMER is not set
# Remove the HPET character device.
# CONFIG_HPET is not set
# Remove the ACPI PM timer clocksource.
# CONFIG_X86_PM_TIMER is not set
# Retain x86 cycle-order validation; does not calibrate TSC.
CONFIG_CLOCKSOURCE_VALIDATE_LAST_CYCLE=y
# Retain virtio bus.
CONFIG_VIRTIO=y
# Retain Firecracker MMIO transport.
CONFIG_VIRTIO_MMIO=y
# Retain MMIO discovery.
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# Retain virtio PCI transport.
CONFIG_VIRTIO_PCI=y
# Retain block storage.
CONFIG_VIRTIO_BLK=y
# Retain isolated networking.
CONFIG_VIRTIO_NET=y
# Retain console transport.
CONFIG_VIRTIO_CONSOLE=y
# Retain vsock family.
CONFIG_VSOCKETS=y
# Retain vsock transport.
CONFIG_VIRTIO_VSOCKETS=y
# Retain entropy framework.
CONFIG_HW_RANDOM=y
# Retain virtio entropy.
CONFIG_HW_RANDOM_VIRTIO=y
# Retain root filesystem.
CONFIG_EXT4_FS=y
# Retain writable overlay.
CONFIG_OVERLAY_FS=y
# Retain tmpfs.
CONFIG_TMPFS=y
# Retain device filesystem.
CONFIG_DEVTMPFS=y
# Retain execd boot contract.
CONFIG_DEVTMPFS_MOUNT=y
# Retain process inspection.
CONFIG_PROC_FS=y
# Retain device inspection.
CONFIG_SYSFS=y
# Retain devpts terminals.
CONFIG_UNIX98_PTYS=y
# Retain cgroup v2.
CONFIG_CGROUPS=y
# Retain process controller.
CONFIG_CGROUP_PIDS=y
# Retain CPU controller.
CONFIG_CGROUP_SCHED=y
# Retain CPU placement controller.
CONFIG_CPUSETS=y
# Retain memory controller.
CONFIG_MEMCG=y
# Retain I/O controller.
CONFIG_BLK_CGROUP=y
# Retain mount and cgroup namespaces.
CONFIG_NAMESPACES=y
# Retain UTS isolation.
CONFIG_UTS_NS=y
# Retain IPC isolation.
CONFIG_IPC_NS=y
# Retain user isolation.
CONFIG_USER_NS=y
# Retain PID isolation.
CONFIG_PID_NS=y
# Retain network isolation.
CONFIG_NET_NS=y
# Retain networking.
CONFIG_NET=y
# Retain IPv4.
CONFIG_INET=y
# Retain packet filtering.
CONFIG_NETFILTER=y
# Retain filter features.
CONFIG_NETFILTER_ADVANCED=y
# Retain connection tracking.
CONFIG_NF_CONNTRACK=y
# Retain nftables.
CONFIG_NF_TABLES=y
# Retain inet tables.
CONFIG_NF_TABLES_INET=y
# Retain NAT expressions.
CONFIG_NFT_NAT=y
# Retain masquerading.
CONFIG_NFT_MASQ=y
# Retain legacy iptables.
CONFIG_IP_NF_IPTABLES=y
# Retain legacy filtering.
CONFIG_IP_NF_FILTER=y
# Retain legacy NAT.
CONFIG_IP_NF_NAT=y
# Retain BPF core.
CONFIG_BPF=y
# Retain BPF syscall.
CONFIG_BPF_SYSCALL=y
# Retain BPF JIT.
CONFIG_BPF_JIT=y
# Retain device policy BPF.
CONFIG_CGROUP_BPF=y
