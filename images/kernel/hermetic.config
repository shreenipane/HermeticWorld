# Hermetic policy fragment; merge after base-x86_64.config (TR-VMM-4/5).

# execd boot contract: the kernel mounts devtmpfs at /dev before PID 1
CONFIG_DEVTMPFS_MOUNT=y

# execd: PID 1 reaps orphans via /proc/<pid>/task/<tid>/children
CONFIG_PROC_CHILDREN=y

# T3.1: no time namespace needed
# CONFIG_TIME_NS is not set

# TR-EXD-6: trusted initramfs support, uncompressed or gzip only, none built in
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# TR-VMM-4: cgroup v2 controllers and device BPF
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CPUSETS=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_IOSCHED_BFQ=y
CONFIG_MEMCG=y

# TR-VMM-4: dm-verity and seccomp
CONFIG_BLK_DEV_DM=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_DM_VERITY=y
CONFIG_MD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# TR-VMM-4: fixed build identity; config supplied separately
# CONFIG_IKCONFIG is not set
# CONFIG_LOCALVERSION_AUTO is not set

# TR-VMM-4: namespaces (mount namespaces are part of NAMESPACES)
CONFIG_IPC_NS=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y

# TR-VMM-4: nftables, legacy iptables, TPROXY and conntrack
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IPV6=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y

# TR-VMM-4: prevent accidental host clock reads
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_PTP_1588_CLOCK_KVM is not set
# CONFIG_PTP_1588_CLOCK_VMW is not set
# CONFIG_RTC_HCTOSYS is not set

# TR-VMM-4: root filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

# TR-VMM-5: virtio devices, vsock and entropy
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y

# Phase 3b: deny guest root access to kernel code and memory
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# CONFIG_MODULES is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVKMEM is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_CORE is not set
# CONFIG_X86_MSR is not set
# CONFIG_X86_CPUID is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_BPF_KPROBE_OVERRIDE is not set
# CONFIG_KPROBES is not set
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_BPF_EVENTS is not set
# CONFIG_ACPI_CUSTOM_METHOD is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
# CONFIG_PARAVIRT is not set
# CONFIG_KVM_GUEST is not set
# CONFIG_PARAVIRT_CLOCK is not set
